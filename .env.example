# DO2603 starter 0.2.3. Copy to .env. Never commit actual keys.
# No paid services or model downloads in the default profile.
RAG_MODE=fixture
LLM_PROVIDER=fixture
EMBEDDING_PROVIDER=fixture
API_PORT=8000
WEB_PORT=3000
REDIS_URL=redis://redis:6379/0
LLM_MAX_TOKENS=1024
EMBEDDING_DIM=1024
EMBEDDING_REVISION=1
PROVIDER_TIMEOUT_SECONDS=60
# REAL mode: set RAG_MODE=real and both providers explicitly.
# LLM: gemini | anthropic | openai | ollama
# Embedding: gemini | voyage | openai | ollama
# Never reuse a populated fixture index for real embeddings. See GETTING_STARTED.
LLM_MODEL=
EMBEDDING_MODEL=
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=
OPENAI_API_KEY=
# Explicit endpoint required, e.g. https://api.openai.com/v1 or a vetted gateway.
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-3.5
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large
# Chat model chosen after measuring available RAM/latency and quality.
# mxbai-embed-large emits 1024 dimensions; no padding/truncation.

# Day 5 ChatOps. The Day 4 incoming webhook cannot replace these credentials.
# Obtain both from the dedicated Slack App and keep the real values only in .env.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_BOT_USER_ID=
CHATOPS_REDIS_URL=redis://127.0.0.1:6379/1
CHATOPS_QUEUE_MODE=redis
CHATOPS_TOOL_MODE=mcp
CHATOPS_NAMESPACE=insighthub-dev
CHATOPS_APPROVAL_TTL_SECONDS=60
CHATOPS_MCP_KUBECONFIG=tmp/day5/mcp-readonly.yaml
# Optional separate write identity. Read-only Day 2 kubeconfig must never be reused.
CHATOPS_MUTATION_KUBECONFIG=
CHATOPS_MUTATION_CONTEXT=
